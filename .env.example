# ==================================================
# Telegram Forwarder - Environment Configuration Example
# ==================================================
# Copy this file to .env for local development:
# cp .env.example .env
# DO NOT commit real secrets or production credentials!

# Server & Runtime Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database (MongoDB connection string)
MONGODB_URI=mongodb+srv://botforword_db_user:<db_password>@forwordingbot.rc52yey.mongodb.net/telegram_forwarder?appName=ForwordingBot

# Custom DNS resolvers for Node.js SRV resolution (optional; recommended on Windows with multiple adapters)
DNS_SERVERS=1.1.1.1,8.8.8.8

# Telegram Bot (grammY integration)
TELEGRAM_BOT_TOKEN=

# Album Processing Debounce Window (milliseconds)
ALBUM_DEBOUNCE_MS=600

# System Owner / Fixed Admin Credentials (Auto-provisioned on startup)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePassword123
ADMIN_NAME="System Owner"

# Authentication & Security
JWT_SECRET=super-secret-development-jwt-key-min16chars
JWT_EXPIRES_IN=7d

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173

# Frontend (Vite) Configuration (used by apps/web)
VITE_API_URL=http://localhost:5000/api

# Redis & BullMQ Queue Configuration (Phase 3)
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=5
QUEUE_MAX_JOBS_PER_SECOND=20
QUEUE_RETRY_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=1000
QUEUE_COMPLETED_RETENTION=500
QUEUE_FAILED_RETENTION=1000

