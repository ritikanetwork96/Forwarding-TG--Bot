{
  "name": "@telegram-forwarder/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend web application for telegram-forwarder",
  "scripts": {
    "dev": "vite",
    "build": "npm run build --prefix ../../packages/shared && tsc && vite build",
    "preview": "vite preview",
